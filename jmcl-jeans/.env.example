APP_NAME="JMCL JEANS LTD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- DATABASE ---
# Default: SQLite (zero-config, free, great for local dev & small deployments)
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite   (leave blank to use default path)

# --- To switch to MySQL later, uncomment below and comment out DB_CONNECTION=sqlite ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jmcl_jeans
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# In production over HTTPS, uncomment this so session cookies are never
# sent over plain HTTP:
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# --- MAIL (free local dev option: log driver, or use free Mailtrap/Mailpit) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@jmcljeans.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Store settings (used to seed default shipping/coupon config) ---
STORE_CURRENCY=BDT
STORE_CURRENCY_SYMBOL="৳"

# --- Future paid integrations (placeholders only — NOT required to run the app) ---
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SMS_API_KEY=
WHATSAPP_API_TOKEN=
COURIER_API_KEY=
