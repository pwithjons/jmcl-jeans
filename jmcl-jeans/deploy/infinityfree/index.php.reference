<?php

// This is NOT a full index.php — it only shows the two lines you need to
// change in the real public/index.php (generated by `composer create-project`)
// before uploading it as htdocs/index.php on InfinityFree.
//
// InfinityFree's FTP only gives you access inside htdocs/, so the rest of
// the Laravel app (app/, bootstrap/, vendor/, etc.) can't sit "one level
// above" htdocs the way it does on a normal server. Instead, upload it
// into a subfolder — this guide uses htdocs/laravel_app/ — and change
// index.php's two require paths to point into that subfolder.

// ORIGINAL (works when app code is one level above public/, the normal case):
//   require __DIR__.'/../vendor/autoload.php';
//   $app = require_once __DIR__.'/../bootstrap/app.php';

// CHANGED (when app code is in htdocs/laravel_app/ next to this index.php):
require __DIR__.'/laravel_app/vendor/autoload.php';
$app = require_once __DIR__.'/laravel_app/bootstrap/app.php';

// Every other line in index.php stays exactly as Laravel generated it —
// only these two require paths change.
